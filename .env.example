# Copy this file to .env. Docker Compose reads the root .env.
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://ticketflow:replace-with-a-strong-database-password@localhost:5432/ticketflow
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
PORT=4000
# Development only. Container overrides to development for localhost HTTP.
NODE_ENV=development
SEED_PASSWORD=ReplaceWithAStrongDemoPassword123!
UPLOAD_DIR=uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@example.com
EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_SCAN_REQUIRED=false
# Optional separate MFA encryption secret. Keep stable or existing MFA secrets cannot be decrypted.
MFA_ENCRYPTION_KEY=
INSTALLATION_ID=local-demo
LICENSE_REQUIRED=false
LICENSE_PUBLIC_KEY=
LICENSE_KEY=
