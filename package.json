{
  "name": "ticketflow",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.9"
  }
}
